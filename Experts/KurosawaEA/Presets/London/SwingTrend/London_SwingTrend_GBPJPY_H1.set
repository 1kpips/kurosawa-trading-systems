;==================================================
; London_SwingTrend_GBPJPY_H1.set (CORRECT)
;==================================================

;-------------------------------
; Identity / Meta
;-------------------------------
InpZone=London
InpEaName=London_SwingTrend_GBPJPY_H1
InpMagic=2026012608
InpEaId=ea-london-swingtrend-gbpjpy-h1
InpEaVersion=0.3.1

;-------------------------------
; Target
;-------------------------------
InpTargetPair=GBPJPY
InpTargetTf=PERIOD_H1

;-------------------------------
; Tracking
;-------------------------------
InpTrackEnable=true
InpTrackSendOpen=true

;-------------------------------
; Session (London in JST)
;-------------------------------
InpStartHour=16
InpEndHour=20
InpUtcOffset=9

;-------------------------------
; EMA trend
;-------------------------------
InpEmaFast=50
InpEmaSlow=200
InpUseDirFilter=false
InpEmaDir=0

;-------------------------------
; RSI pullback (SwingTrend-style)
;-------------------------------
InpRsiPeriod=14
InpRsiBuyBelow=44.0
InpRsiSellAbove=56.0

InpUseRsiCrossConfirm=false
InpRsiBuyCrossLevel=0
InpRsiSellCrossLevel=0

;-------------------------------
; ADX trend regime
;-------------------------------
InpUseAdxFilter=true
InpAdxPeriod=14
InpMinAdxToTrade=19.0
InpMaxAdxToTrade=0.0

;-------------------------------
; ATR window (CRITICAL FIX)
;-------------------------------
InpAtrPeriod=14
InpAtrMinPoints=200.0
InpAtrMaxPoints=1200.0

;-------------------------------
; ATR stop model
;-------------------------------
InpSlAtrMult=2.8
InpTpRMultiple=1.5

;-------------------------------
; Risk sizing
;-------------------------------
InpUseRiskSizing=true
InpRiskPercent=0.40
InpFixedLot=0.03
InpMaxLotCap=0.0

;-------------------------------
; Safety guards
;-------------------------------
InpMaxTradesPerDay=0
InpMaxSpreadPoints=45
InpMaxConsecLosses=3
InpResetConsecLossDaily=false
InpDailyLossLimitPercent=2.0
InpCooldownMinutes=120
InpMaxHoldMinutes=0

;-------------------------------
; Placeholders (keep schema)
;-------------------------------
InpUseMinMoveFilter=false
InpBbPeriod=0
InpMinMoveSpreadMult=0.0
InpBbDev=0.0

InpUseWickSignal=false
InpMinBandBreakPoints=0.0
InpMinEdgeOverSpread=0.0

InpSlPoints=0.0
InpTpPoints=0.0

InpUseMidBandExit=false
InpUseTrailing=false
InpTrailStartR=0.0
InpTrailStepAtrMult=0.0

bias_min_gap_points=0.0
require_ema_slope=true
require_reclaim=false
