;==================================================
; London_RangeRevert_EURUSD_M1_loose.set
; Engine : RangeRevertEA
; TF     : M1
; Pair   : EURUSD
; Session: London (JST)
;==================================================

InpZone=London
InpEaName=London_RangeRevert_EURUSD_M1_loose
InpMagic=2026020302
InpEaId=ea-london-rangerevert-eurusd-m1-loose
InpEaVersion=0.4.3

InpTargetPair=EURUSD
InpTargetTf=PERIOD_M1

InpTrackEnable=true
InpTrackSendOpen=true

InpStartHour=16
InpEndHour=22
InpUtcOffset=9

InpDeviationPoints=20

; BB
InpUseMinMoveFilter=false
InpBbPeriod=20
InpMinMoveSpreadMult=0.0
InpBbDev=1.7

; RSI (match your scalp thresholds)
InpUseRsiCrossConfirm=false
InpRsiBuyCrossLevel=0.0
InpRsiSellCrossLevel=0.0
InpRsiPeriod=14
InpRsiBuyBelow=30.0
InpRsiSellAbove=80.0

; Entry quality 
InpRequireReclaim=false
InpUseWickSignal=true
InpMinBandBreakPoints=16.0
InpMinEdgeOverSpread=1.6

; ADX gate (disable MAX bound like your scalp preset)
InpUseAdxFilter=true
InpAdxPeriod=14
InpMinAdxToTrade=0.0
InpMaxAdxToTrade=0.0

; ATR window (match your scalp window)
InpAtrPeriod=14
InpAtrMinPoints=15.0
InpAtrMaxPoints=160.0

; Risk sizing 
InpUseRiskSizing=true
InpRiskPercent=0.20
InpFixedLot=0.01
InpMaxLotCap=1.0

; Safety
InpMaxTradesPerDay=20
InpMaxSpreadPoints=9999
InpMaxConsecLosses=3
InpResetConsecLossDaily=true
InpDailyLossLimitPercent=1.8
InpCooldownMinutes=10
InpMaxHoldMinutes=30

; Exit
InpUseMidBandExit=true

; Trailing off
InpUseTrailing=false
InpTrailStartR=0.0
InpTrailStepAtrMult=0.0

; ATR stop model (this is the key difference vs ScalpEA fixed SL/TP)
; If ATR(14) is ~40 points on EURUSD M1, SL ~= 80 points, TP ~= 184 points
InpSlAtrMult=3.0
InpTpRMultiple=2.8

; EMA placeholders
InpEmaFast=0
InpEmaSlow=0
InpUseDirFilter=false
InpEmaDir=0
