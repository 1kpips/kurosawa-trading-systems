;==================================================
; NewYork_Trend_USDJPY_M15.set
; Engine : TrendEA
; TF     : M15
; Pair   : USDJPY
; Session: New York
; Note   : NY trend continuation (not scalp)
;==================================================

;-------------------------------
; Identity / Meta
;-------------------------------
InpZone=NewYork
InpEaName=NewYork_Trend_USDJPY_M15
InpMagic=2026020606
InpEaId=ea-newyork-trend-usdjpy-m15
InpEaVersion=0.6.3

;-------------------------------
; Target
;-------------------------------
InpTargetPair=USDJPY
InpTargetTf=PERIOD_M15

;-------------------------------
; Tracking
;-------------------------------
InpTrackEnable=true
InpTrackSendOpen=true

;-------------------------------
; Session (New York in JST)
; - Late start to avoid open whipsaw
;-------------------------------
InpStartHour=0
InpEndHour=3
InpUtcOffset=9

;-------------------------------
; EMA / Direction Bias
;-------------------------------
InpEmaFast=20
InpEmaSlow=100
InpUseDirFilter=true
InpEmaDir=0
InpRequireEmaSlope=true

;-------------------------------
; RSI (context only)
;-------------------------------
InpUseRsiCrossConfirm=false
InpRsiPeriod=14
InpRsiBuyBelow=48.0
InpRsiSellAbove=52.0
InpRsiBuyCrossLevel=0.0
InpRsiSellCrossLevel=0.0

;-------------------------------
; Volatility Filter (POINTS)
; USDJPY: 10 points = 1 pip
; - Use ATR Min only (no ATR Max)
;-------------------------------
InpAtrPeriod=14
InpAtrMinPoints=70
InpAtrMaxPoints=0.0

;-------------------------------
; ADX Filter (NY)
;-------------------------------
InpUseAdxFilter=true
InpAdxPeriod=14
InpMinAdxToTrade=18
InpMaxAdxToTrade=38

;-------------------------------
; Stops & Targets
;-------------------------------
InpUseRiskSizing=true
InpRiskPercent=0.25
InpFixedLot=0.01
InpMaxLotCap=0.0

InpSlAtrMult=1.4
InpTpRMultiple=1.0

;-------------------------------
; Trade Limits / Safety
;-------------------------------
InpMaxTradesPerDay=2
InpMaxSpreadPoints=22
InpCooldownMinutes=40
InpMaxHoldMinutes=180

InpMaxConsecLosses=2
InpResetConsecLossDaily=true
InpDailyLossLimitPercent=1.0

;-------------------------------
; Execution
;-------------------------------
InpDeviationPoints=18

;-------------------------------
; Optional / Disabled Features
;-------------------------------
InpUseMinMoveFilter=false
InpBbPeriod=0
InpMinMoveSpreadMult=0.0
InpBbDev=0.0

InpUseWickSignal=false
InpMinBandBreakPips=0.0
InpMinEdgeOverSpread=0.0

InpUseMidBandExit=false

InpUseTrailing=false
InpTrailStartR=0.0
InpTrailStepAtrMult=0.0