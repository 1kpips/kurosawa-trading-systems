;==================================================
; NewYork_SwingTrend_USDCAD_H1.set
; Engine : SwingTrendEA
; TF     : H1
; Pair   : USDCAD
; Session: New York (local)
;==================================================

;-------------------------------
; Identity / Meta
;-------------------------------
InpZone=NewYork
InpEaName=NewYork_SwingTrend_USDCAD_H1
InpMagic=2026012631
InpEaId=ea-ny-swingtrend-usdcad-h1
InpEaVersion=0.3.3

;-------------------------------
; Target
;-------------------------------
InpTargetPair=USDCAD
InpTargetTf=PERIOD_H1

;-------------------------------
; Tracking
;-------------------------------
InpTrackEnable=true
InpTrackSendOpen=true

;-------------------------------
; Session (New York local time)
; - This uses a fixed UTC offset (no DST auto)
; - Winter:  UTC-5  / Summer: UTC-4
; - Example: 09:00 -> 16:00 NY
;-------------------------------
InpStartHour=9
InpEndHour=16
InpUtcOffset=-5

;-------------------------------
; EMA trend bias (H1)
;-------------------------------
InpEmaFast=50
InpEmaSlow=200
InpUseDirFilter=false
InpEmaDir=0

;-------------------------------
; RSI pullback
; - soften slightly to increase opportunities
;-------------------------------
InpUseRsiCrossConfirm=false
InpRsiBuyCrossLevel=0
InpRsiSellCrossLevel=0

InpRsiPeriod=14
InpRsiBuyBelow=44.0
InpRsiSellAbove=56.0

;-------------------------------
; ADX filter (trend regime confirmation)
; - raise min to avoid chop
;-------------------------------
InpUseAdxFilter=true
InpAdxPeriod=14
InpMinAdxToTrade=22.0
InpMaxAdxToTrade=0.0

;-------------------------------
; ATR window gate (POINTS)
; - loosen min/max (your logs suggest ATR blocks dominate)
;-------------------------------
InpAtrPeriod=14
InpAtrMinPoints=70.0
InpAtrMaxPoints=950.0

;-------------------------------
; ATR-based stops
; - slightly improve reward potential
;-------------------------------
InpSlAtrMult=2.2
InpTpRMultiple=1.8

;-------------------------------
; Risk sizing
; - keep risk moderate until PF>1.0 is stable
;-------------------------------
InpUseRiskSizing=true
InpRiskPercent=0.30
InpFixedLot=0.05
InpMaxLotCap=1.50

;-------------------------------
; Frequency & safety
;-------------------------------
InpMaxTradesPerDay=1
InpMaxSpreadPoints=25
InpMaxConsecLosses=2
InpResetConsecLossDaily=false
InpDailyLossLimitPercent=2.0
InpCooldownMinutes=180
InpMaxHoldMinutes=1440

;-------------------------------
; Trailing / exits (disabled)
;-------------------------------
InpUseMidBandExit=false
InpUseTrailing=false
InpTrailStartR=0.0
InpTrailStepAtrMult=0.0

;-------------------------------
; Min-move / BB placeholders
;-------------------------------
InpUseMinMoveFilter=false
InpBbPeriod=0
InpMinMoveSpreadMult=0.0
InpBbDev=0.0

;-------------------------------
; Wick / band placeholders
;-------------------------------
InpUseWickSignal=false
InpMinBandBreakPoints=0.0
InpMinEdgeOverSpread=0.0

;-------------------------------
; Fixed SL/TP placeholders
;-------------------------------
InpSlPoints=0.0
InpTpPoints=0.0

;-------------------------------
; Extra schema columns
; - if your engine/strategy actually reads these, enable them
;-------------------------------
bias_min_gap_points=0.0
require_ema_slope=true
require_reclaim=true
