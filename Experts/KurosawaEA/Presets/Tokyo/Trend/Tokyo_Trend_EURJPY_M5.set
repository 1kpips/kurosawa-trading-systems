;==================================================
; Tokyo_Trend_EURJPY_M5.set
; Engine : TrendEA
; TF     : M5
; Pair   : EURJPY
; Session: Tokyo
; Note   : Low-DD trend scalp, TP=1 fixed
;==================================================

;-------------------------------
; Identity / Meta
;-------------------------------
InpZone=Tokyo
InpEaName=Tokyo_Trend_EURJPY_M5
InpMagic=2026020602
InpEaId=ea-tokyo-trend-eurjpy-m5
InpEaVersion=0.5.1

;-------------------------------
; Target
;-------------------------------
InpTargetPair=EURJPY
InpTargetTf=PERIOD_M5

;-------------------------------
; Tracking
;-------------------------------
InpTrackEnable=true
InpTrackSendOpen=true

;-------------------------------
; Session (Tokyo JST)
;-------------------------------
InpStartHour=9
InpEndHour=16
InpUtcOffset=9

;-------------------------------
; EMA / Direction Bias
;-------------------------------
InpEmaFast=20
InpEmaSlow=100
InpUseDirFilter=true
InpEmaDir=0             
InpRequireEmaSlope=true

;-------------------------------
; RSI (pullback context only)
;-------------------------------
InpUseRsiCrossConfirm=false
InpRsiPeriod=14
InpRsiBuyBelow=45.0
InpRsiSellAbove=55.0
InpRsiBuyCrossLevel=0.0
InpRsiSellCrossLevel=0.0

;-------------------------------
; Volatility Window (POINTS)
; EURJPY: 10 points = 1 pip (typical 3-digit pricing)
;-------------------------------
InpAtrPeriod=14
InpAtrMinPoints=38       
InpAtrMaxPoints=0.0    

;-------------------------------
; ADX Filter (Tokyo trend scalp band)
;-------------------------------
InpUseAdxFilter=true
InpAdxPeriod=14
InpMinAdxToTrade=18
InpMaxAdxToTrade=32

;-------------------------------
; Stops & Targets
;-------------------------------
InpUseRiskSizing=true
InpRiskPercent=0.30
InpFixedLot=0.01
InpMaxLotCap=0.0

InpSlAtrMult=1.6
InpTpRMultiple=1.0       

;-------------------------------
; Trade Limits / Safety
;-------------------------------
InpMaxTradesPerDay=2
InpMaxSpreadPoints=25    
InpCooldownMinutes=35
InpMaxHoldMinutes=90

InpMaxConsecLosses=2
InpResetConsecLossDaily=true
InpDailyLossLimitPercent=1.0

;-------------------------------
; Execution
;-------------------------------
InpDeviationPoints=20   

;-------------------------------
; Optional / Disabled Features
;-------------------------------
InpUseMinMoveFilter=false
InpBbPeriod=0
InpMinMoveSpreadMult=0.0
InpBbDev=0.0

InpUseWickSignal=false
InpMinBandBreakPips=0.0
InpMinEdgeOverSpread=0.0

InpUseMidBandExit=false

InpUseTrailing=false
InpTrailStartR=0.0
InpTrailStepAtrMult=0.0
