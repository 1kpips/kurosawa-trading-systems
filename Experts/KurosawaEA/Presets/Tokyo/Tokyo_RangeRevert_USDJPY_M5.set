;==================================================
; Tokyo_RangeRevert_USDJPY_M5.set
;==================================================

;-------------------------------
; Identity / Meta
;-------------------------------
InpZone=Tokyo
InpEaName=Tokyo_RangeRevert_USDJPY_M5
InpMagic=2026012704
InpEaId=ea-tokyo-rangerevert-usdjpy-m5
InpEaVersion=0.3.0

;-------------------------------
; Target
;-------------------------------
InpTargetPair=USDJPY
InpTargetTf=PERIOD_M5

;-------------------------------
; Tracking
;-------------------------------
InpTrackEnable=true
InpTrackSendOpen=true

;-------------------------------
; Session (Tokyo session, JST)
; Quiet range-focused window
;-------------------------------
InpStartHour=9
InpEndHour=15
InpUtcOffset=9

;-------------------------------
; Bollinger Bands (range core)
;-------------------------------
InpBbPeriod=20
InpBbDev=2.0

;-------------------------------
; RSI (mean-reversion confirmation)
;-------------------------------
InpRsiPeriod=14
InpRsiBuyBelow=30.0
InpRsiSellAbove=70.0

;-------------------------------
; ATR window gate (POINTS)
; Tight volatility only
;-------------------------------
InpAtrPeriod=14
InpAtrMinPoints=6.0
InpAtrMaxPoints=25.0

;-------------------------------
; Fixed SL / TP (POINTS)
; Mean-reversion prefers fixed exits
;-------------------------------
InpSlPoints=15
InpTpPoints=10

;-------------------------------
; Risk sizing
;-------------------------------
InpUseRiskSizing=true
InpRiskPercent=0.30
InpFixedLot=0.05
InpMaxLotCap=0.8

;-------------------------------
; Safety / frequency
;-------------------------------
InpMaxTradesPerDay=4
InpMaxSpreadPoints=25
InpMaxConsecLosses=3
InpResetConsecLossDaily=false
InpDailyLossLimitPercent=2.0
InpCooldownMinutes=20
InpMaxHoldMinutes=90

;-------------------------------
; ADX filter (range protection)
; Block if trend strength increases
;-------------------------------
InpUseAdxFilter=true
InpAdxPeriod=14
InpMinAdxToTrade=0.0
InpMaxAdxToTrade=18.0

;-------------------------------
; Min-move vs spread sanity
;-------------------------------
InpUseMinMoveFilter=true
InpMinMoveSpreadMult=2.0

;-------------------------------
; Optional market activity filter
; (usually OFF for Tokyo ranges)
;-------------------------------
InpUseMarketRangeFilter=false
InpRangeTf=PERIOD_M5
InpRangeWindowStartHour=9
InpRangeWindowStartMinute=0
InpRangeWindowEndHour=12
InpRangeWindowEndMinute=0
InpRangeMinPoints=0
InpRangeMaxPoints=999999
InpRangeRequireWindowDone=true

;-------------------------------
; Placeholders (schema alignment)
;-------------------------------
InpBiasTF=PERIOD_M15
InpBiasEmaFast=0
InpBiasEmaSlow=0
InpBiasMinGapPoints=0

InpEntryEma=0

InpUseRsiCrossConfirm=false
InpRsiBuyCrossLevel=0
InpRsiSellCrossLevel=0

InpUseWickSignal=false
InpMinBandBreakPips=0.0
InpMinEdgeOverSpread=0.0

InpUseDirFilter=false
InpEmaFast=0
InpEmaSlow=0
InpEmaDir=0

InpUseMidBandExit=false
InpUseTrailing=false
InpTrailStartR=0.0
InpTrailStepAtrMult=0.0
