;==================================================
; Tokyo_RangeRevert_NZDJPY_M5.set
; Engine : RangeRevertEA
; TF     : M5
; Pair   : NZDJPY
; Session: Tokyo (JST)
;==================================================

;-------------------------------
; Identity / Meta
;-------------------------------
InpZone=Tokyo
InpEaName=Tokyo_RangeRevert_NZDJPY_M5
InpMagic=2026020403
InpEaId=ea-tokyo-rangerevert-nzdjpy-m5
InpEaVersion=0.4.6

;-------------------------------
; Target
;-------------------------------
InpTargetPair=NZDJPY
InpTargetTf=PERIOD_M5

;-------------------------------
; Tracking
;-------------------------------
InpTrackEnable=true
InpTrackSendOpen=true

;-------------------------------
; Session (Tokyo, JST)
;-------------------------------
InpStartHour=9
InpEndHour=15
InpUtcOffset=9

;-------------------------------
; Execution
;-------------------------------
InpDeviationPoints=20

;-------------------------------
; Bollinger Bands
;-------------------------------
InpBbPeriod=25
InpBbDev=1.6

;-------------------------------
; RSI (Tokyo range tuned)
;-------------------------------
InpRsiPeriod=14
InpRsiBuyBelow=40.0
InpRsiSellAbove=70.0

;-------------------------------
; Entry quality
;-------------------------------
InpRequireReclaim=false
InpMinBandBreakPoints=14.0
InpMinEdgeOverSpread=1.4

;-------------------------------
; ADX filter (range only)
;-------------------------------
InpUseAdxFilter=true
InpAdxPeriod=14
InpMaxAdxToTrade=24.0   

;-------------------------------
; ATR window (POINTS)
;-------------------------------
InpAtrPeriod=14
InpAtrMinPoints=0.0
InpAtrMaxPoints=0.0

;-------------------------------
; Risk sizing
;-------------------------------
InpUseRiskSizing=true
InpRiskPercent=0.20
InpFixedLot=0.01
InpMaxLotCap=1.0

;-------------------------------
; Safety / Frequency
;-------------------------------
InpMaxTradesPerDay=12
InpMaxSpreadPoints=25
InpMaxConsecLosses=3
InpResetConsecLossDaily=true
InpDailyLossLimitPercent=1.8
InpCooldownMinutes=15
InpMaxHoldMinutes=90

;-------------------------------
; Exit logic
;-------------------------------
InpUseMidBandExit=false

;-------------------------------
; ATR-based stop model
;-------------------------------
InpSlAtrMult=1.2
InpTpRMultiple=1.6

;-------------------------------
; EMA placeholders (unused)
;-------------------------------
InpEmaFast=0
InpEmaSlow=0
InpUseDirFilter=false
InpEmaDir=0
