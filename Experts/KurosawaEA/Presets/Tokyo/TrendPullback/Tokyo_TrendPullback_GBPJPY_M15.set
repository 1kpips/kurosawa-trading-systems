;==================================================
; Tokyo_TrendPullback_GBPJPY_M15.set
;==================================================

;-------------------------------
; Identity / Meta
;-------------------------------
InpZone=Tokyo
InpEaName=Tokyo_TrendPullback_GBPJPY_M15
InpMagic=2026012716
InpEaId=ea-tokyo-trendpullback-gbpjpy-m15
InpEaVersion=0.3.0

;-------------------------------
; Target
;-------------------------------
InpTargetPair=GBPJPY
InpTargetTf=PERIOD_M15

;-------------------------------
; Tracking
;-------------------------------
InpTrackEnable=true
InpTrackSendOpen=true

;-------------------------------
; Session (Tokyo session, JST)
; GBPJPY still trades in Asia but volatility is moderate
;-------------------------------
InpStartHour=9
InpEndHour=15
InpUtcOffset=9

;-------------------------------
; Trend bias (higher TF)
; Use H1 bias for M15 entries
;-------------------------------
InpBiasTF=PERIOD_H1
InpBiasEmaFast=50
InpBiasEmaSlow=200
InpBiasMinGapPoints=120.0

;-------------------------------
; Entry EMA (pullback reclaim)
;-------------------------------
InpEntryEma=20

;-------------------------------
; RSI confirmation (pullback)
; JPY cross tends to pull back deeper
;-------------------------------
InpRsiPeriod=14
InpRsiBuyBelow=42.0
InpRsiSellAbove=58.0

;-------------------------------
; ATR window gate (POINTS)
; GBPJPY is volatile even in Tokyo
;-------------------------------
InpAtrPeriod=14
InpAtrMinPoints=180.0
InpAtrMaxPoints=650.0

;-------------------------------
; Risk & stop model (ATR-based)
;-------------------------------
InpUseRiskSizing=true
InpRiskPercent=0.30
InpFixedLot=0.05
InpMaxLotCap=0.6

InpSlAtrMult=2.0
InpTpRMultiple=1.4

;-------------------------------
; Frequency & safety
;-------------------------------
InpMaxTradesPerDay=3
InpMaxSpreadPoints=28
InpMaxConsecLosses=3
InpResetConsecLossDaily=false
InpDailyLossLimitPercent=2.0
InpCooldownMinutes=45
InpMaxHoldMinutes=360

;-------------------------------
; Market activity range filter
; Avoid dead Tokyo chop
;-------------------------------
InpUseMarketRangeFilter=true
InpRangeTf=PERIOD_M15
InpRangeWindowStartHour=9
InpRangeWindowStartMinute=0
InpRangeWindowEndHour=12
InpRangeWindowEndMinute=0
InpRangeMinPoints=160
InpRangeMaxPoints=999999
InpRangeRequireWindowDone=true

;-------------------------------
; ADX / BB / fixed SLTP (placeholders)
;-------------------------------
InpUseAdxFilter=false
InpAdxPeriod=0
InpMinAdxToTrade=0.0
InpMaxAdxToTrade=0.0

InpBbPeriod=0
InpBbDev=0.0

InpSlPoints=0
InpTpPoints=0

;-------------------------------
; Min-move filter (unused here)
;-------------------------------
InpUseMinMoveFilter=false
InpMinMoveSpreadMult=0.0

;-------------------------------
; Schema-alignment placeholders
;-------------------------------
InpUseRsiCrossConfirm=false
InpRsiBuyCrossLevel=0
InpRsiSellCrossLevel=0

InpUseWickSignal=false
InpMinBandBreakPips=0.0
InpMinEdgeOverSpread=0.0

InpUseDirFilter=false
InpEmaFast=0
InpEmaSlow=0
InpEmaDir=0

InpUseMidBandExit=false
InpUseTrailing=false
InpTrailStartR=0.0
InpTrailStepAtrMult=0.0
