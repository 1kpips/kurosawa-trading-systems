;==================================================
; Tokyo_SwingTrend_USDJPY_H1.set
; Engine : SwingTrendEA
; TF     : H1
; Pair   : USDJPY
; Session: Tokyo
;==================================================

;-------------------------------
; Identity / Meta
;-------------------------------
InpZone=Tokyo
InpEaName=Tokyo_SwingTrend_USDJPY_H1
InpMagic=2026012703
InpEaId=ea-tokyo-swingtrend-usdjpy-h1
InpEaVersion=0.3.2

;-------------------------------
; Target
;-------------------------------
InpTargetPair=USDJPY
InpTargetTf=PERIOD_H1

;-------------------------------
; Tracking
;-------------------------------
InpTrackEnable=true
InpTrackSendOpen=true

;-------------------------------
; Session (Tokyo, JST)
;-------------------------------
InpStartHour=9
InpEndHour=18
InpUtcOffset=9

;-------------------------------
; EMA trend bias (H1)
;-------------------------------
InpEmaFast=50
InpEmaSlow=200
InpUseDirFilter=false
InpEmaDir=0

;-------------------------------
; RSI pullback (USDJPY smoother than GBPJPY)
;-------------------------------
InpUseRsiCrossConfirm=false
InpRsiBuyCrossLevel=0
InpRsiSellCrossLevel=0

InpRsiPeriod=14
InpRsiBuyBelow=45.0
InpRsiSellAbove=55.0

;-------------------------------
; ADX filter (light, trend confirmation)
;-------------------------------
InpUseAdxFilter=true
InpAdxPeriod=14
InpMinAdxToTrade=21.0
InpMaxAdxToTrade=0.0

;-------------------------------
; ATR window gate (POINTS)
; USDJPY: 1 pip ≈ 10 points
;-------------------------------
InpAtrPeriod=14
InpAtrMinPoints=150.0     ; ~15 pips
InpAtrMaxPoints=800.0     ; ~80 pips

;-------------------------------
; ATR-based stops
;-------------------------------
InpSlAtrMult=2.5
InpTpRMultiple=1.6

;-------------------------------
; Risk sizing
;-------------------------------
InpUseRiskSizing=true
InpRiskPercent=0.35
InpFixedLot=0.03
InpMaxLotCap=0.80

;-------------------------------
; Frequency & safety
;-------------------------------
InpMaxTradesPerDay=2
InpMaxSpreadPoints=25
InpMaxConsecLosses=2
InpResetConsecLossDaily=false
InpDailyLossLimitPercent=2.0
InpCooldownMinutes=120
InpMaxHoldMinutes=720

;-------------------------------
; Trailing / exits (disabled)
;-------------------------------
InpUseMidBandExit=false
InpUseTrailing=false
InpTrailStartR=0.0
InpTrailStepAtrMult=0.0

;-------------------------------
; Min-move / BB placeholders
;-------------------------------
InpUseMinMoveFilter=false
InpBbPeriod=0
InpMinMoveSpreadMult=0.0
InpBbDev=0.0

;-------------------------------
; Wick / band placeholders
;-------------------------------
InpUseWickSignal=false
InpMinBandBreakPoints=0.0
InpMinEdgeOverSpread=0.0

;-------------------------------
; Fixed SL/TP placeholders
;-------------------------------
InpSlPoints=0.0
InpTpPoints=0.0

;-------------------------------
; Extra schema columns
;-------------------------------
bias_min_gap_points=0.0
require_ema_slope=true
require_reclaim=false
